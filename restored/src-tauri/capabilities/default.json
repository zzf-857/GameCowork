{
  "//": "从 cowork.exe 二进制内嵌 ACL 字符串重建的默认能力集（见 COMMAND_SURFACE.md）",
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Codely Desktop 主窗口默认能力",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "core:app:allow-tauri-version",
    "core:app:allow-identifier",
    "core:app:allow-bundle-type",
    "core:event:allow-register-listener",
    "core:event:allow-remove-listener",
    "core:app:allow-default-window-icon",
    "updater:default",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered"
  ]
}
